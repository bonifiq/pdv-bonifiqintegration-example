# A demo abre com o cliente mock e não precisa de credenciais.
VITE_BONIFIQ_MODE=mock

# Para testar a API real localmente, use VITE_BONIFIQ_MODE=api e preencha abaixo.
# ATENÇÃO: variáveis VITE_* são incluídas no bundle do navegador. Nunca use esta
# arquitetura em um PDV de produção; proteja as credenciais em um backend/serviço.
VITE_BONIFIQ_API_BASE_URL=https://api.bonifiq.com.br/v1/pvt
VITE_BONIFIQ_API_USERNAME=
VITE_BONIFIQ_API_PASSWORD=
